# Copy to your shell environment (or an IDE run configuration). Never commit real values.

# --- Database (PostgreSQL 14+) ---
DB_URL=jdbc:postgresql://localhost:5432/servegood
DB_USERNAME=servegood
DB_PASSWORD=change-me

# --- Security ---
# At least 32 random bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# true when served over HTTPS
JWT_SECURE_COOKIE=false

# --- First admin, created on startup only if no admin exists (password: 12+ characters) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- URLs ---
PORT=8081
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8081/uploads

# --- Local demo content (development only) ---
# Seeds six fictional Andheri restaurants and demo accounts on the .test domain:
#   admin@servegood.test, owner@servegood.test, reviewer@servegood.test,
#   diner@servegood.test, diner2@servegood.test
# all using SEED_DEMO_PASSWORD. Runs only when the database has no restaurants.
SEED_DEMO=false
SEED_DEMO_PASSWORD=
